        float3 physics:diagonalInertia = (0.00035680461, 0.00021941932, 0.00045575899)

        def Scope "visuals"
        {
            def Xform "mesh" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                rel material:binding = </omx_f/Looks/Black_Matte>
                def "geometry" (
                    prepend payload = @package://open_manipulator_description/meshes/omx_f/follower_01_base.stl@
                )
                {
                    double3 xformOp:scale = (0.001, 0.001, 0.001)
                    uniform token[] xformOpOrder = ["xformOp:scale"]
                }
            }
        }

        def Scope "collisions"
        {
            def Xform "mesh" (
