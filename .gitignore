# Datasets, checkpoints, and raw video live on Hugging Face Hub / lab NAS — see README.md.
# Never commit them here even accidentally.
data/
datasets/
checkpoints/
*.ckpt
*.pt
*.pth
*.safetensors
*.mp4
*.mov
*.avi

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Third-party source clones installed in editable mode (uv pip install -e ".\lerobot[...]").
# This is upstream huggingface/lerobot, ~389MB and its own nested .git — never ours to track.
# See scripts/setup_laptop.ps1, docs/environment.md.
lerobot/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local-only scratch (never intended to be shared)
*.local.*
.cache/
outputs/

# Isaac Sim build artefacts live in ~/isaaclab_volume, never here
sim/__pycache__/

# Crash dumps -- a container/process leaves these at repo root sometimes, ~10GB, never useful.
core
core.*

# Local Isaac Sim / URDF working assets (2026-10-07 [柏宇決定]): generated or third-party clones, ~120 MB.
